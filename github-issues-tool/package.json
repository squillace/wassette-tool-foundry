{
  "name": "github-issues-tool",
  "version": "0.1.0",
  "description": "A Wassette-compatible tool for reading, commenting on, and closing GitHub issues via the GitHub API",
  "type": "module",
  "main": "github-issues.js",
  "scripts": {
    "build:component": "jco componentize -w ./wit -o github-issues.wasm github-issues.js",
    "transpile": "jco transpile github-issues.wasm -o dist/transpiled",
    "test": "node test.js"
  },
  "dependencies": {
    "@bytecodealliance/componentize-js": "0.18.1",
    "@bytecodealliance/jco": "^1.11.1"
  },
  "keywords": [
    "wassette",
    "webassembly",
    "github",
    "api",
    "wasm",
    "component"
  ],
  "license": "Apache-2.0"
}