{
  "name": "github-pr-tool",
  "version": "0.1.0",
  "description": "A Wassette-compatible tool for fetching GitHub pull requests via the GitHub API",
  "type": "module",
  "main": "github-pr.js",
  "scripts": {
    "build:component": "jco componentize -w ./wit -o github-pr.wasm github-pr.js",
    "transpile": "jco transpile github-pr.wasm -o dist/transpiled",
    "test": "node test.js"
  },
  "dependencies": {
    "@bytecodealliance/componentize-js": "0.18.1",
    "@bytecodealliance/jco": "^1.11.1"
  },
  "keywords": [
    "wassette",
    "webassembly",
    "github",
    "api",
    "wasm",
    "component",
    "pull-requests"
  ],
  "license": "Apache-2.0"
}