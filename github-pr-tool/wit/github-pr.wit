package wassette:github-pr@0.1.0;

interface github-api {
    /// Represents a GitHub pull request
    record pull-request {
        id: u64,
        number: u32,
        title: string,
        body: option<string>,
        state: string,
        created-at: string,
        updated-at: string,
        author: string,
        labels: list<string>,
        url: string,
        merged: bool,
        mergeable: option<bool>,
        head-ref: string,
        base-ref: string,
        head-sha: string,
        base-sha: string,
    }

    /// Result type for API operations
    variant api-result {
        success(list<pull-request>),
        error(string),
    }

    /// List pull requests from a GitHub repository
    /// Parameters: owner (string), repo (string), state (optional: "open", "closed", "all")
    list-pull-requests: func(owner: string, repo: string, state: option<string>) -> api-result;
}

world github-pr {
    export github-api;
}